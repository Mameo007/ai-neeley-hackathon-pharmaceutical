# Copy to .env (git-ignored) and fill in. Never commit .env or paste the key anywhere.
ANTHROPIC_API_KEY=
# A or B - recorded on every row of logs/api_usage.csv
PHARMER_PARTNER=
# SEC fair access requires a real name and email on every request. The Librarian
# refuses to fetch without it; an anonymous or fake contact risks the demo IP
# being blocked. Example: PHARMER_SEC_UA="Jane Doe jane@example.com"
PHARMER_SEC_UA=
