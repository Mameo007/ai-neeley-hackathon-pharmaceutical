# Secrets - never commit API keys
.env

# Local environment and caches
.venv/
__pycache__/
*.pyc

# Run outputs and per-call API usage logs (local; summarize into docs/build-log.md)
runs/
logs/

# Raw SEC downloads behind the sample corpus (regenerate with scripts/build_sample_corpus.py)
data/sample/*/_raw/

# macOS folder metadata (lists local folder and file names)
.DS_Store
